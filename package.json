{
  "name": "shop24mart-print-bridge",
  "version": "1.0.0",
  "type": "module",
  "description": "Shop24Mart Thermal Print Bridge",
  "main": "main.js",
  "author": "Shop24Mart",
  "scripts": {
    "start": "node cloud-server.js",
    "bridge": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.shop24mart.printbridge",
    "productName": "Shop24Mart Print Suite",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowToChangeInstallationDirectory": false
    },
    "files": [
      "main.js",
      "preload.js",
      "ui.js",
      "index.html",
      "styles.css",
      "icon.ico",
      "node_modules/**/*",
      "!test.js",
      "!cloud-server.js",
      "!*.log"
    ]
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}